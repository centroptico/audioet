# Clave de OpenRouter. Solo en el servidor (Vercel → Settings → Environment Variables).
# El navegador nunca la ve y no hace falta para compilar.
OPENROUTER_API_KEY=

# Opcional. OpenRouter lo usa como HTTP-Referer. Si se omite, se usa el origen de la petición.
# OPENROUTER_SITE_URL=https://audioetdev.vercel.app
