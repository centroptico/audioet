{
  "name": "audioet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg.mjs",
    "copy-ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "dev": "node scripts/copy-ffmpeg.mjs && next dev",
    "build": "node scripts/copy-ffmpeg.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:chunks": "node --import tsx scripts/verify-chunks.ts",
    "test:wasm": "node --import tsx scripts/verify-wasm.ts"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "next": "16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "puppeteer-core": "24.30.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
